<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PrimexGlass</RootNamespace>
    <AssemblyName>ORBIT OPTIMIZER</AssemblyName>
    <ApplicationIcon>..\assets\orbit.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>ORBIT OPTIMIZER</Product>
    <Company>PRIMEx</Company>
    <Copyright>� 2026 PRIMEx</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <EmbeddedResource Include="Optimizer\tweaks.json" />
  </ItemGroup>

  <!-- Build the Vite frontend before publish so dist/ is fresh -->
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(SkipFrontend)'==''">
    <Exec Command="npm run build" WorkingDirectory="..\frontend" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
